APP_NAME=AI-Powered HR Hiring Automation
ENVIRONMENT=development
API_V1_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173
POSTGRES_DB=hr_hiring
POSTGRES_USER=hr_user
POSTGRES_PASSWORD=
# Leave DATABASE_URL blank to use the local SQLite database (hr_hiring_local.db).
# For PostgreSQL, provide a full SQLAlchemy connection URL.
DATABASE_URL=

OPENAI_API_KEY=

# ElevenLabs private browser conversations (WebRTC voice + WebSocket text; no phone number)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
PHONE_DEFAULT_REGION=PK
# Gmail SMTP: use a Google App Password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-hr-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=your-hr-gmail-address@gmail.com

GOOGLE_CALENDAR_CREDENTIALS_FILE=
GOOGLE_CALENDAR_TIME_ZONE=UTC
SCHEDULING_TEST_MODE=true
EMAIL_AUTOMATION_REJECT_BELOW_SCORE=50
EMAIL_AUTOMATION_REVIEW_THROUGH_SCORE=60
EMAIL_AUTOMATION_INTERVIEW_FROM_SCORE=70
EMAIL_AUTOMATION_INTERVIEW_THROUGH_SCORE=90
EMAIL_AUTOMATION_ABOVE_RANGE_ACTION=pending_review

# Authentication (generate a random secret locally; never commit backend/.env)
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
HR_ALLOWED_EMAIL=anasarman997@gmail.com
