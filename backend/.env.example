APP_NAME=AI-Powered HR Hiring Automation
ENVIRONMENT=development
API_V1_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_DB=hr_hiring
POSTGRES_USER=hr_user
POSTGRES_PASSWORD=
# Leave DATABASE_URL blank to use the local SQLite database (hr_hiring_local.db).
# For PostgreSQL, provide a full SQLAlchemy connection URL.
DATABASE_URL=

OPENAI_API_KEY=
# Gmail SMTP: use a Google App Password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-hr-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=your-hr-gmail-address@gmail.com

GOOGLE_CALENDAR_CREDENTIALS_FILE=
GOOGLE_CALENDAR_TIME_ZONE=UTC
SCHEDULING_TEST_MODE=true
# CV score rules: at or below the first number the candidate gets an automatic
# rejection email; at or above the second they get an automatic approval email;
# scores in between wait in the HR portal for an Accept / Reject decision.
EMAIL_AUTOMATION_REJECT_BELOW_SCORE=50
EMAIL_AUTOMATION_AUTO_APPROVE_FROM_SCORE=90

# Authentication
# Leave AUTH_SECRET_KEY blank: a private key is generated once and saved in
# backend/.auth_secret (never committed). Or set your own, 32+ random characters.
AUTH_SECRET_KEY=
# The only email allowed to log in to the HR portal.
HR_ALLOWED_EMAIL=anasarman997@gmail.com
# HR login password (12+ characters). The HR account is created from this when the
# backend starts, so no emailed code is needed. Change it here to change the password.
HR_PASSWORD=
